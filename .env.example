# Copia este archivo a .env (en tu PC, nunca se commitea) y completa valores.
# cp .env.example .env   (Linux/Mac)
# Copy-Item .env.example .env   (Windows)

# --- Modelos / APIs (opcional, opencode los lee del entorno) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Git identidad (usada por install si git no está configurado) ---
# DOTFILES_GIT_NAME=Tu Nombre
# DOTFILES_GIT_EMAIL=tu@email.com

# --- Repo privado de skills (si lo usas) ---
# SKILLS_PRIVATE_REPO=git@github.com:TU_USUARIO/skills-private.git

# --- Zed / Opencode defaults ---
# OPECODE_MODEL=opencode/muse-spark-1.3-contributor-free
# ZED_THEME_DARK=Ayu Mirage
